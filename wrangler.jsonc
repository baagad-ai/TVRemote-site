{
  "name": "theremote-site",
  "pages_build_output_dir": "./_site",
  "compatibility_date": "2026-10-07",
  "send_metrics": false,
  "d1_databases": [
    {
      "binding": "METRICS_DB",
      "database_name": "the-remote-download-metrics",
      "database_id": "0b9109ef-88b4-4521-9fcc-d043a09e9ef8",
      "migrations_dir": "analytics/migrations"
    }
  ],
  "vars": {
    "METRICS_ENABLED": "true",
    "METRICS_ALLOWED_ORIGINS": "https://theremote-site.pages.dev",
    "METRICS_ALLOWED_RELEASES": "0.1.0-beta.9-b93bcf1e9cf6,0.1.0-beta.8.2-b8dfd7f8b41e,0.1.0-beta.8.1-3fbb8e414cdf,0.1.0-beta.8-8ea325cd117f,0.1.0-beta.7-b60880306e71",
    "METRICS_DAILY_CAP": "1000",
    "METRICS_PER_MINUTE": "20",
    "EVENTS_DAILY_CAP": "20000",
    "EVENTS_PER_MINUTE": "120"
  },
  "env": {
    "preview": {
      "d1_databases": [
        {
          "binding": "METRICS_DB",
          "database_name": "the-remote-metrics-preview",
          "database_id": "184c8200-32d2-470d-ba16-ff27e3febf9f",
          "migrations_dir": "analytics/migrations"
        },
        {
          "binding": "BETA_DB",
          "database_name": "the-remote-beta-requests",
          "database_id": "361c5549-6046-4d2c-8a34-23bdcce72db0"
        }
      ],
      "vars": {
        "METRICS_ENABLED": "true",
        "METRICS_ALLOWED_ORIGINS": "https://*.theremote-site.pages.dev",
        "EVENTS_ALLOW_ORIGIN_WILDCARD": "true",
        "METRICS_ALLOWED_RELEASES": "0.1.0-beta.9-b93bcf1e9cf6,0.1.0-beta.8.2-b8dfd7f8b41e,0.1.0-beta.8.1-3fbb8e414cdf,0.1.0-beta.8-8ea325cd117f,0.1.0-beta.7-b60880306e71",
        "METRICS_DAILY_CAP": "1000",
        "METRICS_PER_MINUTE": "20",
        "EVENTS_DAILY_CAP": "20000",
        "EVENTS_PER_MINUTE": "120",
        "BETA_ALLOW_PREVIEW_ORIGINS": "true",
        "TURNSTILE_TEST_MODE": "true",
        "TURNSTILE_SECRET_KEY": "1x0000000000000000000000000000000AA"
      }
    }
  }
}
