{
  "name": "the-remote-public-site",
  "private": true,
  "scripts": {
    "build": "node site/build-react.mjs",
    "build:production": "node site/build-react.mjs --production",
    "build:pages": "node site/build-pages.mjs",
    "build:pages:production": "node site/build-pages.mjs --production",
    "build:github-transition": "node site/build-github-transition.mjs",
    "build:scene": "node site/build-react.mjs",
    "test": "node --test --test-isolation=none site/deployment-config.test.mjs site/src/download-metrics.test.mjs site/beta-request.test.mjs worker/test/*.test.mjs analytics/tests/*.test.mjs"
  },
  "dependencies": {
    "@gsap/react": "2.1.2",
    "gsap": "3.15.0",
    "motion": "14.0.0",
    "ogl": "1.0.11",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  }
}
